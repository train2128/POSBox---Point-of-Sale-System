/* ============================================
   POSBox - Font Overlay: Medium (15px baseline)
   Loaded on top of the color theme file.
   Shapes: pill/capsule radius = height / 2, pinned
   via min-height so the capsule is exact.
   ============================================ */

QLabel {
    font-size: 15px;
}

QLineEdit {
    font-size: 15px;
    padding: 9px 14px;
    min-height: 24px;
    border-radius: 22px;
}

QPushButton {
    font-size: 15px;
    padding: 9px 18px;
    min-height: 24px;
    border-radius: 22px;
}

QComboBox {
    font-size: 15px;
    padding: 8px 6px 8px 14px;
    min-height: 24px;
    border-radius: 21px;
}

QSpinBox, QDoubleSpinBox, QTimeEdit {
    font-size: 15px;
    padding: 7px 6px 7px 10px;
    min-height: 24px;
    border-radius: 20px;
}

QTableWidget, QTableView {
    font-size: 15px;
}

QHeaderView::section {
    font-size: 15px;
    padding: 8px;
}

QTabBar::tab {
    font-size: 15px;
    padding: 8px 18px;
}

QDateEdit {
    font-size: 15px;
    padding: 6px 6px 6px 12px;
    min-height: 24px;
    border-radius: 19px;
}

/* Tables header override (Tickets app) */
QTableView QHeaderView::section {
    font-size: 13px;
    padding: 8px 12px;
}

/* Cart */
.cart-item-name  { font-size: 15px; }
.cart-item-price { font-size: 15px; }
.cart-item-remove { font-size: 15px; }

/* Discount items */
.discount-separator-label { font-size: 13px; }
.discount-name   { font-size: 15px; }
.discount-amount { font-size: 15px; }

/* Inventory uses ID selectors in the color theme; mirror the selected scale
   here so those more-specific widget rules do not pin it to medium sizing. */
QLabel#headerTitle { font-size: 28px; }
QLabel#headerSubtitle { font-size: 15px; }
QLabel#footerLabel { font-size: 13px; }
QPushButton#kpiLabel, QPushButton#kpiLabelOut, QPushButton#kpiLabelLow { font-size: 15px; }
QPushButton#tabProducts, QPushButton#tabCategories, QPushButton#tabDiscounts { font-size: 15px; }
QPushButton#actionAdd, QPushButton#actionEdit, QPushButton#actionDelete { font-size: 15px; }
QLineEdit#searchBox { font-size: 15px; }
QTableWidget#mainTable { font-size: 15px; }
QTableWidget#mainTable QHeaderView::section { font-size: 15px; }

/* Dialogs */



QLabel[uiRole="desc"], QLabel[uiRole="field"] {
    font-size: 12px;
}

/* Register */
QFrame#cartPanel { min-width: 340px; }
QLabel#product-name { font-size: 13px; }
QLabel#product-price-label { font-size: 12px; }
QLabel#totalLabel { font-size: 26px; }

/* Modern dialogs */
QLabel#modalTitle { font-size: 17px; }
QLabel#modalSubtitle { font-size: 12px; }
QLabel#modalSideTitle { font-size: 10px; }
QLabel#modalFieldLabel, QLabel#modalRowLabel { font-size: 12px; }
QLabel#modalChoiceTitle { font-size: 14px; }
QLabel#modalStripLabel, QLabel#modalMoneySuffix, QLabel#modalMatch, QLabel#modalSwitchLabel { font-size: 13px; }
QLabel#modalStripValue { font-size: 14px; }
QLineEdit#modalMoneyBig { font-size: 24px; min-height: 38px; }
QPushButton#modalCancelLink { font-size: 13px; }
QPushButton#discountChip { font-size: 12px; }
QLabel#discountLineName, QLabel#discountLineValue { font-size: 12px; }
QLabel#discountTotal { font-size: 32px; }
QTableWidget#openTicketsTable QHeaderView::section { font-size: 10px; }
QTableWidget#openTicketsTable { font-size: 13px; }

QLabel#modalRowLabel { min-width: 108px; max-width: 108px; }

/* Login window */
QLabel#loginTitle { font-size: 24px; }
QLabel#loginWelcome { font-size: 19px; }
QLabel#loginRole, QLabel#launcherVersion { font-size: 11px; }
QLabel#loginMessage { font-size: 12px; }
QLabel#launcherAppName { font-size: 13px; }

/* Message window, Save ticket, variants */
QLabel#messageTitle { font-size: 17px; }
QLabel#messageText { font-size: 13px; }
QLabel#messageAmount { font-size: 26px; }
QLabel#saveTicketLeft { font-size: 28px; }
QLabel#variantStock { font-size: 12px; }
QTextEdit#modalTextBox { font-size: 13px; }

/* Notification panel */
QLabel#notifHeaderTitle { font-size: 15px; }
QLabel#notifSubtitle, QLabel#notifDate { font-size: 11px; }
QLabel#notifSection { font-size: 10px; }
QLabel#notifTitle { font-size: 13px; }
QLabel#notifMessage { font-size: 12px; }
QPushButton#notifMarkAll, QPushButton#notifClearAll { font-size: 11px; }
QLabel#notifEmptyTitle { font-size: 14px; }
QLabel#notifEmptyHint { font-size: 12px; }
