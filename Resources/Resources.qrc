    </qresource>
    <qresource prefix="/Assets">
        <file>images/Assets/discount.png</file>
        <file>images/Assets/down_arrow.png</file>
        <file>images/Assets/logout.png</file>
        <file>images/Assets/notification_active.png</file>
        <file>images/Assets/notification.png</file>
        <file>images/Assets/product_default.png</file>
        <file>images/Assets/up_arrow.png</file>
        <file>images/Assets/delete.png</file>
        <file>images/Assets/delete_black.png</file>
        <file>images/Assets/discount_black.png</file>
        <file>images/Assets/down_arrow_black.png</file>
        <file>images/Assets/logout_black.png</file>
        <file>images/Assets/notification_active_black.png</file>
        <file>images/Assets/notification_black.png</file>
        <file>images/Assets/up_arrow_black.png</file>
        <file>images/Assets/refresh.png</file>
        <file>images/Assets/refresh_black.png</file>
